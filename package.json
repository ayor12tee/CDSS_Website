{
  "name": "cdss-website",
  "version": "1.0.0",
  "private": true,
  "description": "Website and publications hub for CDSS (Nig.) Limited",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:seed": "node --env-file-if-exists=.env.local --import tsx scripts/seed.ts",
    "user:create": "node --env-file-if-exists=.env.local --import tsx scripts/create-user.ts",
    "illustrations": "node scripts/generate-illustrations.cjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "jose": "^6.2.12",
    "next": "^16.3.6",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-directive": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "unist-util-visit": "^5.1.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.6",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
